<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.court.controller.JudgeCauseListController" styleClass="page" spacing="18">
    <padding><Insets top="28" right="32" bottom="28" left="32"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="3">
            <Label fx:id="titleLabel" text="Cause list" styleClass="page-title"/>
            <Label fx:id="subtitleLabel" styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button styleClass="secondary-button" onAction="#handlePrevious">
            <graphic><FontIcon iconLiteral="fth-chevron-left" iconSize="15"/></graphic>
        </Button>
        <DatePicker fx:id="datePicker" prefWidth="150"/>
        <Button styleClass="secondary-button" onAction="#handleNext">
            <graphic><FontIcon iconLiteral="fth-chevron-right" iconSize="15"/></graphic>
        </Button>
        <Button text="Today" styleClass="secondary-button" onAction="#handleToday"/>
    </HBox>

    <VBox styleClass="card" VBox.vgrow="ALWAYS">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label fx:id="progressLabel" styleClass="card-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Double-click a case to open its file." styleClass="hint-label"/>
        </HBox>
        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="srCol" text="Sr." prefWidth="50" minWidth="45" maxWidth="60"/>
                <TableColumn fx:id="timeCol" text="Time" prefWidth="85"/>
                <TableColumn fx:id="caseNoCol" text="Case no." prefWidth="125"/>
                <TableColumn fx:id="titleCol" text="Parties" prefWidth="260"/>
                <TableColumn fx:id="stageCol" text="Stage" prefWidth="100"/>
                <TableColumn fx:id="hearingCol" text="Hearing" prefWidth="100"/>
                <TableColumn fx:id="actionsCol" text="Actions" prefWidth="170" minWidth="170" maxWidth="180"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
