<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- BorderPane: header on top, menu on the left, screens in the centre -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.court.controller.RegistrarDashboardController"
            styleClass="app-root" prefWidth="1200" prefHeight="760">

    <top>
        <HBox styleClass="app-header" alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>
            <Label text="⚖" styleClass="header-icon"/>
            <VBox alignment="CENTER_LEFT">
                <Label fx:id="courtNameLabel" styleClass="header-title"/>
                <Label text="Courtroom Management System" styleClass="header-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER_RIGHT" spacing="2">
                <Label fx:id="userNameLabel" styleClass="header-user"/>
                <Label fx:id="roleLabel" styleClass="role-badge"/>
            </VBox>
            <Button text="Logout" styleClass="logout-button" onAction="#handleLogout"/>
        </HBox>
    </top>

    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" spacing="4" prefWidth="220">
            <padding><Insets top="20" right="12" bottom="20" left="12"/></padding>
            <Label text="MENU" styleClass="sidebar-heading"/>
            <Button fx:id="homeButton" text="Home" styleClass="nav-button" maxWidth="Infinity" onAction="#showHome"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <ScrollPane fitToWidth="true" styleClass="page-scroll">
                <VBox spacing="20" styleClass="page">
                    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

                    <VBox spacing="2">
                        <Label fx:id="welcomeLabel" styleClass="page-title"/>
                        <Label fx:id="dateLabel" styleClass="page-subtitle"/>
                    </VBox>

                    <HBox spacing="16">
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <Label text="Judges" styleClass="stat-label"/>
                            <Label fx:id="judgeCountLabel" text="-" styleClass="stat-value"/>
                        </VBox>
                        <VBox styleClass="stat-card,stat-card-gold" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <Label text="Lawyers" styleClass="stat-label"/>
                            <Label fx:id="lawyerCountLabel" text="-" styleClass="stat-value"/>
                        </VBox>
                        <VBox styleClass="stat-card,stat-card-green" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <Label text="Courtrooms" styleClass="stat-label"/>
                            <Label fx:id="courtroomCountLabel" text="-" styleClass="stat-value"/>
                        </VBox>
                    </HBox>

                    <VBox styleClass="card" spacing="10">
                        <Label text="Courtroom allocation" styleClass="card-title"/>
                        <Label text="Which judge sits in which courtroom" styleClass="card-subtitle"/>
                        <ListView fx:id="allocationList" prefHeight="260"/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </StackPane>
    </center>
</BorderPane>
