<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- StackPane centres the login card on the dark background -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.court.controller.LoginController"
           styleClass="login-root" prefWidth="1100" prefHeight="700">

    <HBox styleClass="login-card" maxWidth="920" maxHeight="560">

        <!-- ===================== Left: branding, features and live figures ===================== -->
        <VBox styleClass="login-brand" prefWidth="410" minWidth="340" spacing="20">
            <padding><Insets top="44" right="40" bottom="36" left="40"/></padding>

            <StackPane styleClass="brand-logo" alignment="CENTER">
                <Label text="⚖"/>
            </StackPane>

            <VBox spacing="6">
                <Label fx:id="courtNameLabel" styleClass="brand-title" wrapText="true"/>
                <Label text="Courtroom Management System" styleClass="brand-subtitle"/>
            </VBox>

            <Region styleClass="brand-divider"/>

            <VBox spacing="16">
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <StackPane styleClass="feature-tile"><FontIcon iconLiteral="fth-file-text" iconSize="16"/></StackPane>
                    <VBox spacing="2">
                        <Label text="File and track cases" styleClass="feature-title"/>
                        <Label text="Online filing, scrutiny and live status" styleClass="feature-text"/>
                    </VBox>
                </HBox>
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <StackPane styleClass="feature-tile"><FontIcon iconLiteral="fth-calendar" iconSize="16"/></StackPane>
                    <VBox spacing="2">
                        <Label text="Clash-free hearing schedules" styleClass="feature-title"/>
                        <Label text="No judge, room or lawyer double-booked" styleClass="feature-text"/>
                    </VBox>
                </HBox>
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <StackPane styleClass="feature-tile"><FontIcon iconLiteral="fth-book-open" iconSize="16"/></StackPane>
                    <VBox spacing="2">
                        <Label text="Cause lists, orders and judgments" styleClass="feature-title"/>
                        <Label text="Every hearing recorded in the case history" styleClass="feature-text"/>
                    </VBox>
                </HBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Filled from the database once it loads; hidden if the database is unreachable -->
            <HBox fx:id="liveStatsBox" spacing="10" visible="false" managed="false">
                <VBox styleClass="live-stat" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label fx:id="pendingStatLabel" styleClass="live-value"/>
                    <Label text="Pending cases" styleClass="live-label"/>
                </VBox>
                <VBox styleClass="live-stat" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label fx:id="hearingsStatLabel" styleClass="live-value"/>
                    <Label text="Hearings today" styleClass="live-label"/>
                </VBox>
                <VBox styleClass="live-stat" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label fx:id="disposedStatLabel" styleClass="live-value"/>
                    <Label text="Decided (30 days)" styleClass="live-label"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- ===================== Right: sign-in form ===================== -->
        <VBox styleClass="login-form" HBox.hgrow="ALWAYS" spacing="8">
            <padding><Insets top="48" right="48" bottom="34" left="48"/></padding>

            <Label text="Welcome back" styleClass="form-title"/>
            <Label text="Sign in with your court account to continue." styleClass="form-subtitle" wrapText="true"/>

            <Label text="Username" styleClass="field-label">
                <VBox.margin><Insets top="22"/></VBox.margin>
            </Label>
            <HBox fx:id="usernameGroup" styleClass="input-group">
                <FontIcon iconLiteral="fth-user" iconSize="16"/>
                <TextField fx:id="usernameField" promptText="registrar, judge1 or lawyer1" HBox.hgrow="ALWAYS"/>
            </HBox>

            <Label text="Password" styleClass="field-label">
                <VBox.margin><Insets top="8"/></VBox.margin>
            </Label>
            <HBox fx:id="passwordGroup" styleClass="input-group">
                <FontIcon iconLiteral="fth-lock" iconSize="16"/>
                <PasswordField fx:id="passwordField" promptText="Enter your password" HBox.hgrow="ALWAYS"
                               onAction="#handleLogin"/>
            </HBox>

            <HBox alignment="CENTER_LEFT">
                <VBox.margin><Insets top="6"/></VBox.margin>
                <CheckBox fx:id="rememberMeCheck" text="Remember my username"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink text="Forgot password?" onAction="#handleForgotPassword"/>
            </HBox>

            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" maxWidth="Infinity"
                   visible="false" managed="false">
                <graphic><FontIcon iconLiteral="fth-alert-circle" iconSize="15"/></graphic>
            </Label>

            <Button fx:id="loginButton" text="Sign in" styleClass="primary-button" maxWidth="Infinity"
                    defaultButton="true" onAction="#handleLogin">
                <VBox.margin><Insets top="12"/></VBox.margin>
            </Button>

            <HBox spacing="10" alignment="CENTER">
                <VBox.margin><Insets top="4" bottom="4"/></VBox.margin>
                <Region styleClass="or-line" HBox.hgrow="ALWAYS"/>
                <Label text="or" styleClass="or-label"/>
                <Region styleClass="or-line" HBox.hgrow="ALWAYS"/>
            </HBox>

            <Button text="Check a case status without signing in" styleClass="secondary-button" maxWidth="Infinity"
                    onAction="#handleCaseStatus">
                <graphic><FontIcon iconLiteral="fth-search" iconSize="15"/></graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS" minHeight="12"/>

            <Label text="Demo accounts:  registrar / admin123   ·   judge1 / judge123   ·   lawyer1 / lawyer123"
                   styleClass="hint-label" wrapText="true"/>
        </VBox>
    </HBox>
</StackPane>
