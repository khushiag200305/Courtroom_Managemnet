<?xml version="1.0" encoding="UTF-8"?>

<?import com.court.ui.CourthouseGraphic?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- StackPane centres the login card on the dark background -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.court.controller.LoginController"
           styleClass="login-root" prefWidth="1100" prefHeight="720">

    <fx:define>
        <ToggleGroup fx:id="roleGroup"/>
    </fx:define>

    <HBox styleClass="login-card" maxWidth="940" maxHeight="590">

        <!-- ===================== Left: the court ===================== -->
        <VBox styleClass="login-brand" prefWidth="430" minWidth="360" spacing="14">
            <padding><Insets top="32" right="36" bottom="30" left="36"/></padding>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <StackPane styleClass="brand-logo">
                    <FontIcon iconLiteral="mdi2s-scale-balance" iconSize="26"/>
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="courtNameLabel" styleClass="brand-title" wrapText="true"/>
                    <Label text="e-Court management system" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>

            <StackPane styleClass="courthouse-box">
                <padding><Insets top="10" bottom="2"/></padding>
                <CourthouseGraphic size="300"/>
            </StackPane>

            <Label text="“Justice delayed is justice denied.”" styleClass="motto" maxWidth="Infinity"/>

            <HBox styleClass="session-row" spacing="8" alignment="CENTER_LEFT">
                <StackPane fx:id="sessionDot" styleClass="session-dot"/>
                <Label fx:id="sessionLabel" styleClass="session-text"/>
            </HBox>

            <VBox styleClass="cause-box" spacing="6">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <FontIcon iconLiteral="mdi2g-gavel" iconSize="15"/>
                    <Label text="Next on today's cause list" styleClass="cause-heading"/>
                </HBox>
                <VBox fx:id="causeListBox" spacing="2"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Filled from the database once it loads; hidden if the database is unreachable -->
            <HBox fx:id="liveStatsBox" spacing="10" visible="false" managed="false">
                <VBox styleClass="live-stat" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label fx:id="pendingStatLabel" styleClass="live-value"/>
                    <Label text="Pending cases" styleClass="live-label"/>
                </VBox>
                <VBox styleClass="live-stat" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label fx:id="hearingsStatLabel" styleClass="live-value"/>
                    <Label text="Hearings today" styleClass="live-label"/>
                </VBox>
                <VBox styleClass="live-stat" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label fx:id="disposedStatLabel" styleClass="live-value"/>
                    <Label text="Decided (30 days)" styleClass="live-label"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- ===================== Right: sign-in form ===================== -->
        <VBox styleClass="login-form" HBox.hgrow="ALWAYS" spacing="8">
            <padding><Insets top="40" right="46" bottom="30" left="46"/></padding>

            <Label text="Welcome back" styleClass="form-title"/>
            <Label text="Choose your role and sign in with your court account." styleClass="form-subtitle" wrapText="true"/>

            <!-- Role tabs: ToggleButtons in one ToggleGroup, so only one can be selected -->
            <HBox spacing="8">
                <VBox.margin><Insets top="16" bottom="4"/></VBox.margin>
                <ToggleButton fx:id="registrarTab" text="Registrar" toggleGroup="$roleGroup" selected="true"
                              styleClass="role-tab" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                    <graphic><FontIcon iconLiteral="mdi2b-bank" iconSize="17"/></graphic>
                </ToggleButton>
                <ToggleButton fx:id="judgeTab" text="Judge" toggleGroup="$roleGroup"
                              styleClass="role-tab" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                    <graphic><FontIcon iconLiteral="mdi2g-gavel" iconSize="17"/></graphic>
                </ToggleButton>
                <ToggleButton fx:id="lawyerTab" text="Lawyer" toggleGroup="$roleGroup"
                              styleClass="role-tab" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                    <graphic><FontIcon iconLiteral="fth-briefcase" iconSize="16"/></graphic>
                </ToggleButton>
            </HBox>

            <Label text="Username" styleClass="field-label">
                <VBox.margin><Insets top="8"/></VBox.margin>
            </Label>
            <HBox fx:id="usernameGroup" styleClass="input-group">
                <FontIcon iconLiteral="fth-user" iconSize="16"/>
                <TextField fx:id="usernameField" HBox.hgrow="ALWAYS"/>
            </HBox>

            <Label text="Password" styleClass="field-label">
                <VBox.margin><Insets top="8"/></VBox.margin>
            </Label>
            <HBox fx:id="passwordGroup" styleClass="input-group">
                <FontIcon iconLiteral="fth-lock" iconSize="16"/>
                <PasswordField fx:id="passwordField" promptText="Enter your password" HBox.hgrow="ALWAYS"
                               onAction="#handleLogin"/>
            </HBox>

            <HBox alignment="CENTER_LEFT">
                <VBox.margin><Insets top="6"/></VBox.margin>
                <CheckBox fx:id="rememberMeCheck" text="Remember me on this computer"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink text="Forgot password?" onAction="#handleForgotPassword"/>
            </HBox>

            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" maxWidth="Infinity"
                   visible="false" managed="false">
                <graphic><FontIcon iconLiteral="fth-alert-circle" iconSize="15"/></graphic>
            </Label>

            <Button fx:id="loginButton" text="Sign in" styleClass="primary-button" maxWidth="Infinity"
                    defaultButton="true" onAction="#handleLogin">
                <VBox.margin><Insets top="10"/></VBox.margin>
            </Button>

            <HBox spacing="10" alignment="CENTER">
                <VBox.margin><Insets top="4" bottom="4"/></VBox.margin>
                <Region styleClass="or-line" HBox.hgrow="ALWAYS"/>
                <Label text="or" styleClass="or-label"/>
                <Region styleClass="or-line" HBox.hgrow="ALWAYS"/>
            </HBox>

            <Button text="Check a case status without signing in" styleClass="secondary-button" maxWidth="Infinity"
                    onAction="#handleCaseStatus">
                <graphic><FontIcon iconLiteral="fth-search" iconSize="15"/></graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS" minHeight="10"/>

            <Label fx:id="demoHint" styleClass="hint-label" wrapText="true"/>
        </VBox>
    </HBox>
</StackPane>
