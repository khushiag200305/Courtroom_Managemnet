<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Scrutiny queue: list of new filings on the left, the selected filing on the right -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.court.controller.ScrutinyController" styleClass="page" spacing="18">
    <padding><Insets top="28" right="32" bottom="28" left="32"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="3">
            <Label text="Scrutiny" styleClass="page-title"/>
            <Label text="Check new filings, then register them or return them for correction." styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="chip,chip-neutral"/>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox styleClass="card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <HBox styleClass="input-group" maxWidth="420">
                <FontIcon iconLiteral="fth-search" iconSize="15"/>
                <TextField fx:id="searchField" promptText="Search parties, type or lawyer" HBox.hgrow="ALWAYS"/>
            </HBox>
            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="filedCol" text="Filed" prefWidth="100"/>
                    <TableColumn fx:id="titleCol" text="Parties" prefWidth="230"/>
                    <TableColumn fx:id="typeCol" text="Type" prefWidth="90"/>
                    <TableColumn fx:id="lawyerCol" text="Filed by" prefWidth="150"/>
                    <TableColumn fx:id="waitCol" text="Waiting" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Details of the selected filing -->
        <VBox styleClass="card" prefWidth="400" minWidth="360" maxWidth="440">
            <StackPane VBox.vgrow="ALWAYS">
                <VBox fx:id="emptyDetails" alignment="CENTER" spacing="8">
                    <FontIcon iconLiteral="fth-mouse-pointer" iconSize="24" styleClass="empty-icon"/>
                    <Label text="Select a filing to check it." styleClass="empty-text"/>
                </VBox>
                <VBox fx:id="detailsBox" spacing="14" visible="false">
                    <VBox spacing="6">
                        <HBox fx:id="detailChips" spacing="8"/>
                        <Label fx:id="detailTitle" styleClass="dialog-title" wrapText="true"/>
                        <Label fx:id="detailMeta" styleClass="page-subtitle" wrapText="true"/>
                    </VBox>
                    <ScrollPane fitToWidth="true" styleClass="page-scroll" VBox.vgrow="ALWAYS">
                        <VBox fx:id="detailBody" spacing="14"/>
                    </ScrollPane>
                    <HBox spacing="10">
                        <Button text="Return for correction" styleClass="secondary-button" onAction="#handleReturn"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <graphic><FontIcon iconLiteral="fth-corner-up-left" iconSize="15"/></graphic>
                        </Button>
                        <Button text="Register case" styleClass="primary-button" onAction="#handleRegister"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <graphic><FontIcon iconLiteral="fth-check" iconSize="15"/></graphic>
                        </Button>
                    </HBox>
                </VBox>
            </StackPane>
        </VBox>
    </HBox>
</VBox>
