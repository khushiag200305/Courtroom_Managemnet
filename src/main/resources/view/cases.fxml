<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Case list used by judges ("My cases", "Reserved judgments") and lawyers ("My cases", "Returned filings") -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.court.controller.CasesController" styleClass="page" spacing="18">
    <padding><Insets top="28" right="32" bottom="28" left="32"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="3">
            <Label fx:id="titleLabel" styleClass="page-title"/>
            <Label fx:id="subtitleLabel" styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox fx:id="headerActions" spacing="10" alignment="CENTER_RIGHT"/>
    </HBox>

    <VBox styleClass="card" VBox.vgrow="ALWAYS">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <HBox styleClass="input-group" HBox.hgrow="ALWAYS" maxWidth="420">
                <FontIcon iconLiteral="fth-search" iconSize="15"/>
                <TextField fx:id="searchField" promptText="Search case number or parties" HBox.hgrow="ALWAYS"/>
            </HBox>
            <ComboBox fx:id="stageFilter" prefWidth="170"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel" styleClass="chip,chip-neutral"/>
        </HBox>

        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="caseNoCol" text="Case no." prefWidth="125"/>
                <TableColumn fx:id="titleCol" text="Parties" prefWidth="250"/>
                <TableColumn fx:id="typeCol" text="Type" prefWidth="90"/>
                <TableColumn fx:id="stageCol" text="Stage" prefWidth="100"/>
                <TableColumn fx:id="nextCol" text="Next hearing" prefWidth="120"/>
                <TableColumn fx:id="otherCol" prefWidth="150"/>
                <TableColumn fx:id="actionsCol" text="Actions" prefWidth="170" minWidth="170" maxWidth="190"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
