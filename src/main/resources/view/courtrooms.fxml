<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.court.controller.CourtroomsController" styleClass="page" spacing="18">
    <padding><Insets top="28" right="32" bottom="28" left="32"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="3">
            <Label text="Courtrooms" styleClass="page-title"/>
            <Label text="Rooms where hearings are held, and who sits in each." styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Add courtroom" styleClass="primary-button" onAction="#handleAdd">
            <graphic><FontIcon iconLiteral="fth-plus" iconSize="15"/></graphic>
        </Button>
    </HBox>

    <VBox styleClass="card" VBox.vgrow="ALWAYS">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <HBox styleClass="input-group" HBox.hgrow="ALWAYS" maxWidth="420">
                <FontIcon iconLiteral="fth-search" iconSize="15"/>
                <TextField fx:id="searchField" promptText="Search rooms or judges" HBox.hgrow="ALWAYS"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel" styleClass="chip,chip-neutral"/>
        </HBox>

        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="roomCol" text="Room" prefWidth="80"/>
                <TableColumn fx:id="nameCol" text="Court" prefWidth="230"/>
                <TableColumn fx:id="judgeCol" text="Presiding judge" prefWidth="220"/>
                <TableColumn fx:id="todayCol" text="Hearings today" prefWidth="120"/>
                <TableColumn fx:id="statusCol" text="Status" prefWidth="100"/>
                <TableColumn fx:id="actionsCol" text="Actions" prefWidth="120" minWidth="120" maxWidth="130"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
